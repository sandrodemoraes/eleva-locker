# ELEVA LOCKER — site piloto (Modelo A: servidor local no condomínio)
# Copie para .env no PC do site:  copy .env.site.example .env
# Ajuste APP_URL_BASE para o IP fixo do PC na LAN do local.

SECRET_KEY=ALTERE_GERE_COM_tools_criar_env_site_py
SKIP_BACKUP=0
FLASK_DEBUG=0

# Identificação do site (opcional — logs e pasta de backup)
ELEVA_SITE_CODIGO=piloto-050
ELEVA_SITE_NOME=Condomínio Piloto

# URL local — ESP e totem usam este IP (NÃO Matriz, NÃO domínio público)
APP_URL_BASE=http://192.168.50.10:15000
ELEVA_PAINEL_URL=http://192.168.50.10:15000/dashboard

# WhatsApp: endereço texto (sem IP local na mensagem)
NOTIF_INCLUIR_LINK_TOTEM=0

# Banco — SQLite local (recomendado piloto); Postgres opcional
# DATABASE_URL=postgresql://eleva:senha@localhost:5432/elevalocker

# ESP32 — produção no site
ESP32_TOKEN=eleva-esp32-token-2026
ESP32_MODO_SIMULACAO=0

# Notificações — console na bancada; evolution em produção
NOTIF_MODO=console
# NOTIF_MODO=evolution
# NOTIF_WHATSAPP_ATIVO=1
# WHATSAPP_API_URL=http://192.168.50.10:8080
# WHATSAPP_API_KEY=
# WHATSAPP_INSTANCIA=eleva-locker

# Totem — id do armário criado por tools/bootstrap_site_piloto.py
TOTEM_ARMARIO_ID=1

# Encomendas
ENCOMENDA_DIAS_VALIDADE=7

# Totem ajuda (opcional)
TOTEM_AJUDA_TELEFONE=
TOTEM_AJUDA_ALERTA=1

# WireGuard — só gestão Matriz; operação NÃO depende do túnel
# ELEVA_WG_IP=10.255.0.50

# LGPD — manter desligado no piloto até Fase 3
LGPD_AVISO_ATIVO=0
LGPD_CONSENTIMENTO_USUARIO=0
LGPD_TITULAR_ATIVO=0
LGPD_JOB_ATIVO=0
