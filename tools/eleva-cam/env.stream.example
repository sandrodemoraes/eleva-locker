# Copie para .env.stream (não versionar) e preencha.
# copy env.stream.example .env.stream

# Chave da transmissão YouTube Studio → Transmitir
YOUTUBE_STREAM_KEY=

# RTSP da câmera (Intelbras / Hik / etc.)
# Exemplo Intelbras comum:
# rtsp://admin:SENHA@192.168.1.64:554/cam/realmonitor?channel=1&subtype=0
CAMERA_RTSP_URL=

# URL RTMP do YouTube (raramente muda)
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
