# ================================================================
# ELEVA LOCKER — variáveis de produção (nuvem)
# Copie este arquivo para "deploy/.env" e edite os valores.
# NUNCA suba o .env real para o Git (já está no .gitignore).
# ================================================================

# ---- Domínio + HTTPS ----
# Aponte o DNS de elevalocker.com.br (registro A) para o IP do VPS ANTES de subir.
SITE_DOMAIN=elevalocker.com.br
# E-mail para o certificado Let's Encrypt (recebe avisos de expiração).
TLS_EMAIL=seu-email@exemplo.com

# ---- Segurança (TROQUE TODOS) ----
# Gere uma chave forte, ex.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=TROQUE-por-uma-chave-aleatoria-longa
POSTGRES_USER=eleva
POSTGRES_PASSWORD=TROQUE-por-uma-senha-forte
POSTGRES_DB=elevalocker

# ---- Notificações (comece simples; ligue depois) ----
# console = só loga; producao = envia de verdade
NOTIF_MODO=console
NOTIF_WHATSAPP_ATIVO=0
WHATSAPP_PROVIDER=evolution
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_INSTANCIA=

# ---- Leads de energia solar (para quem avisar) ----
# WhatsApp que recebe aviso de novo orçamento (só dígitos, ex.: 5548999998888)
ORCAMENTO_SOLAR_WHATSAPP=
ORCAMENTO_SOLAR_EMAIL=
TOTEM_AJUDA_TELEFONE=
