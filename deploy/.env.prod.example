# ================================================================
# ELEVA LOCKER — variáveis de produção (nuvem)
# Copie este arquivo para "deploy/.env" e edite os valores.
# NUNCA suba o .env real para o Git (já está no .gitignore).
# ================================================================

# ---- Domínio + HTTPS ----
# Aponte o DNS de elevalocker.com.br (registro A) para o IP do VPS ANTES de subir.
SITE_DOMAIN=elevalocker.com.br
# E-mail para o certificado Let's Encrypt (recebe avisos de expiração).
TLS_EMAIL=seu-email@exemplo.com

# ---- Segurança (TROQUE TODOS) ----
# Gere uma chave forte, ex.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=TROQUE-por-uma-chave-aleatoria-longa
POSTGRES_USER=eleva
POSTGRES_PASSWORD=TROQUE-por-uma-senha-forte
POSTGRES_DB=elevalocker

# ---- Notificações ----
# console = só loga; producao = envia de verdade.
# Para LIGAR o WhatsApp (com o overlay docker-compose.whatsapp.yml), use:
#   NOTIF_MODO=producao  e  NOTIF_WHATSAPP_ATIVO=1
NOTIF_MODO=console
NOTIF_WHATSAPP_ATIVO=0
WHATSAPP_PROVIDER=evolution
# Com o overlay do WhatsApp, o app fala com o Evolution pela rede interna:
#   WHATSAPP_API_URL=http://evolution:8080
WHATSAPP_API_URL=
# IMPORTANTE: WHATSAPP_API_KEY é a MESMA chave usada como AUTHENTICATION_API_KEY do Evolution.
WHATSAPP_API_KEY=
# Nome da instância que você vai criar no manager do Evolution (ex.: eleva-locker)
WHATSAPP_INSTANCIA=

# ---- WhatsApp na nuvem (Evolution) — só se subir o docker-compose.whatsapp.yml ----
# SERVER_URL do Evolution (via túnel SSH em localhost:8080 para escanear o QR)
EVOLUTION_SERVER_URL=http://localhost:8080
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=TROQUE-por-uma-senha-forte
EVOLUTION_DB_NAME=evolution_db

# ---- Leads de energia solar (para quem avisar) ----
# WhatsApp que recebe aviso de novo orçamento (só dígitos, ex.: 5548999998888)
ORCAMENTO_SOLAR_WHATSAPP=
ORCAMENTO_SOLAR_EMAIL=
TOTEM_AJUDA_TELEFONE=
