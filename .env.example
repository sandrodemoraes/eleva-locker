# ELEVA LOCKER — variáveis de ambiente (copie para .env)

SECRET_KEY=ElevaLocker2026
SKIP_BACKUP=0

# Flask
APP_URL_BASE=http://localhost:15000

# Banco — deixe vazio para SQLite (dev) ou use PostgreSQL:
# DATABASE_URL=postgresql://eleva:eleva@db:5432/elevalocker

# ESP32
ESP32_TOKEN=eleva-esp32-token-2026
ESP32_MODO_SIMULACAO=1

# Notificações (console = log local)
NOTIF_MODO=console

# Encomendas — prazo para retirada (dias); após isso status retida
ENCOMENDA_DIAS_VALIDADE=3

# Totem — armário fixo na bancada (ex.: Matriz id=2)
TOTEM_ARMARIO_ID=2
# Ajuda no totem — WhatsApp da portaria (DDD+numero, ex: 48999998888)
TOTEM_AJUDA_TELEFONE=
TOTEM_AJUDA_ALERTA=1
# Depósito sem PIN quando totem fixo no armário (default automático)
# TOTEM_DEPOSITO_SEM_PIN=1
# PIN portaria (opcional): TOTEM_DEPOSITO_PIN=1234

# WhatsApp (para ajuda totem e encomendas)
# NOTIF_WHATSAPP_ATIVO=1
# NOTIF_MODO=evolution
# WHATSAPP_API_URL=http://localhost:8080
# WHATSAPP_API_KEY=sua-chave
# WHATSAPP_INSTANCIA=eleva-locker

# PostgreSQL (docker-compose)
POSTGRES_USER=eleva
POSTGRES_PASSWORD=eleva
POSTGRES_DB=elevalocker

# LGPD — Fase 1 (documentos públicos; 1=link no rodapé do totem)
LGPD_AVISO_ATIVO=1
LGPD_POLITICA_VERSAO=2026-08-30
LGPD_CONTROLADOR_NOME=ELEVA LOCKER — Matriz ELEVA
LGPD_CONTATO_EMAIL=
LGPD_CONTATO_TELEFONE=

# LGPD — Fase 2 (consentimento; 0 = sem mudança operacional)
LGPD_CONSENTIMENTO_USUARIO=0
LGPD_AVISO_TOTEM=0

# LGPD — Fase 3 (direitos titular; 0 = menu oculto)
LGPD_TITULAR_ATIVO=0

# LGPD — Fase 4 (retenção; job 0 = não roda sozinho)
LGPD_RETENCAO_ENCOMENDA_DIAS=365
LGPD_RETENCAO_LOG_DIAS=180
LGPD_RETENCAO_AJUDA_TOTEM_DIAS=90
LGPD_RETENCAO_NOTIFICACAO_DIAS=365
LGPD_JOB_ATIVO=0
LGPD_MASCARAR_TELEFONE=0
