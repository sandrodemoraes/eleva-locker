# ELEVA LOCKER — variáveis de ambiente (copie para .env)

SECRET_KEY=ElevaLocker2026
# Produção: gere com python -c "import secrets; print(secrets.token_hex(32))"
# FLASK_DEBUG=0
# SESSION_COOKIE_SECURE=1
# LOGIN_RATE_LIMIT=10
# LOGIN_RATE_JANELA=900
SKIP_BACKUP=0

# Bancada Matriz — OBRIGATÓRIO no PC 192.168.16.130 (força SQLite)
ELEVA_BANCADA=1

# Backup local (backups/) ou externo (D:)
# BACKUP_DIR=backups
# BACKUP_DIR=D:\ElevaLockerBackup\rotativo
# BACKUP_MAX=5

# Flask
APP_URL_BASE=http://localhost:15000

# Banco — deixe vazio para SQLite (dev) ou use PostgreSQL:
# DATABASE_URL=postgresql://eleva:eleva@db:5432/elevalocker

# ESP32
ESP32_TOKEN=eleva-esp32-token-2026
ESP32_MODO_SIMULACAO=1

# ── Notificações ──────────────────────────────────────────────
# console = imprime no terminal | producao = envia de verdade
NOTIF_MODO=console

NOTIF_EMAIL_ATIVO=1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@elevalocker.com

NOTIF_WHATSAPP_ATIVO=0
WHATSAPP_PROVIDER=evolution
WHATSAPP_API_URL=http://localhost:8080
WHATSAPP_API_KEY=ElevaWhatsApp2026
WHATSAPP_INSTANCIA=eleva-locker
WHATSAPP_SERVER_URL=http://192.168.16.130:8080
WHATSAPP_RETRY_MAX=3
ENCOMENDA_DIAS_VALIDADE=7
TOTEM_AJUDA_TELEFONE=
TOTEM_DEPOSITO_PIN=2026
TOTEM_ARMARIO_ID=3
TOTEM_DEPOSITO_SEM_PIN=1
TOTEM_RATE_LIMIT=8
TOTEM_RATE_JANELA=300

# Meta Cloud API (WHATSAPP_PROVIDER=meta)
# WHATSAPP_META_TOKEN=
# WHATSAPP_META_PHONE_ID=
# WHATSAPP_META_TEMPLATE=encomenda_chegou

NOTIF_SMS_ATIVO=0
SMS_API_URL=
SMS_API_KEY=

# Pagamentos (console = simulado)
PAGAMENTO_MODO=console

# PostgreSQL (docker-compose)
POSTGRES_USER=eleva
POSTGRES_PASSWORD=eleva
POSTGRES_DB=elevalocker

# ── Exemplo produção WhatsApp (Evolution API) ─────────────────
# NOTIF_MODO=producao
# NOTIF_WHATSAPP_ATIVO=1
# APP_URL_BASE=http://192.168.16.130:15000
# WHATSAPP_API_URL=http://192.168.16.130:8080
# WHATSAPP_API_KEY=...
# WHATSAPP_INSTANCIA=eleva-locker
